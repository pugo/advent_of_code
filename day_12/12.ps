% --------------------------------------------------------------------------
%  Advent of Code 2025 in Postscript - Day 12
%  by Anders Piniesjö
%
%  Since the Advent of Code author wants no personal data to be included
%  on GitHub, all input data is injected by the use of 'inject_data.py'.
%  This means that your 'input.txt' should be placed in the same directory
%  as this file and then the inject can be done by a simple 'make':
%
%     $ make
%
%  To run with GhostScript, with injected data:
%
%     $ make run
%
%  To print on a PostScript printer:
%  Send the injected file to the printer: 12_injected.ps
% --------------------------------------------------------------------------

%% ----- Data -------

/input_data_shapes <<
% <<INJECT SHAPES DATA HERE>>
>> def

/input_data_regions [
% <<INJECT REGIONS DATA HERE>>
] def

%% ----- Output -------

/setup_output
{
   /stdout (%stdout) (w) file def
   /print { stdout exch writestring } bind def
   /println { print stdout (\n) writestring } bind def

   /LM   50 def      % Left margin
   /RM   578 def     % Right margin
   /TM   700 def     % Top margin
   /BM   10 def      % Bottom margin
   /fontsize 18 def  % Change this to change font-size
   /ypos TM def      % current y-position
   /lineheight fontsize def

   /font_normal /Times-Roman findfont fontsize scalefont def
   /font_bold /Times-Bold findfont fontsize scalefont def
   font_normal setfont
} def

/newline
 { currentpoint exch pop lineheight sub  % calc y-val
   BM lt                                 % check if less than bottom margin
   { showpage LM TM moveto               % New page
     /ypos TM def }
   { ypos lineheight sub                 % Go left/down
     /ypos exch def
     LM ypos moveto } ifelse
} def

/prtstr
 { dup stringwidth pop      % calc length of string
   currentpoint pop         % get horizontal position
   add RM gt                % sum > right margin?
   {newline} if             % if so, next line
   show
} def

/setnormal { font_normal setfont } bind def
/setbold { font_bold setfont } bind def

%% ---- Utils ------

/min  %% int int -- int   | Return min of two ints
{
   2 copy gt { exch pop } { pop } ifelse
} bind def

/max  %% int int -- int   | Return max of two ints
{
   2 copy lt { exch pop } { pop } ifelse
} bind def

/append   %% array elem -- array with elem   | Append elem to array, returning a new array with result.
{
   1 index length dup 1 add array   % Create new larger array.
   dup 0 6 -1 roll putinterval      % Copy old array into new.
   dup 4 -2 roll                    % Duplicate array and stack roll.
   exch put                         % Put element to end.
} bind def

%% --- Step 1 ----------

/s1_init  %% shapes regions --
{
   /input_regions exch def
   /input_shapes exch def
   /shapes_cell_coverage input_shapes length array def
} bind def


/count_shape_cells  %% shape_number -- cells  | Count number of cells covered by shape
{
   /result 0 def
   input_shapes exch get 
   {
      {
         35 eq { /result result 1 add def } if
      } forall
   } forall
   result
} bind def


/count_shapes_cells
{
   0 1 input_data_shapes length 1 sub
   {
      dup count_shape_cells   % i coverage
      shapes_cell_coverage 3 1 roll put
   } for
} bind def


/test_region  %% region_number -- bool
{
   input_regions exch get
   aload pop
   /shape_counts exch def
   /region_size exch def
   
   /cell_count region_size aload pop mul def

   /shape_count 0 def
   0 1 shape_counts length 1 sub
   {
      /s exch def
      /shape_count shape_count shapes_cell_coverage s get shape_counts s get mul add def
   } for

   (Shape count: ) print shape_count 10 string cvs print (, cell_count: ) print cell_count 10 string cvs println

   shape_count cell_count lt
} bind def


/test_regions
{
   /result 0 def

   0 1 input_regions length 1 sub
   {
      test_region { /result result 1 add def } if
   } for

   result
} bind def


%% ------------------------------

setup_output

input_data_shapes input_data_regions s1_init
count_shapes_cells
test_regions /result_step_1 exch def

% Output to paper
LM TM moveto
setbold (Advent of Code 2025) prtstr setnormal newline newline
(- Day 12 -) prtstr 1 1 6 { pop newline } for
setbold (Result step 1: ) prtstr setnormal result_step_1 100 string cvs prtstr newline newline

% Write to stdout as well
(\nAdvent of Code 2025  - Day 12 - Anders Piniesjö\n) println
(Result step 1: ) print result_step_1 20 string cvs println
