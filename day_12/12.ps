%% ----- Output -------

/setup_output
{
   /stdout (%stdout) (w) file def
   /print { stdout exch writestring } bind def
   /println { print stdout (\n) writestring } bind def

   /LM   50 def      % Left margin
   /RM   578 def     % Right margin
   /TM   700 def     % Top margin
   /BM   10 def      % Bottom margin
   /fontsize 18 def  % Change this to change font-size
   /ypos TM def      % current y-position
   /lineheight fontsize def

   /font_normal /Times-Roman findfont fontsize scalefont def
   /font_bold /Times-Bold findfont fontsize scalefont def
   font_normal setfont
} def

/newline
 { currentpoint exch pop lineheight sub  % calc y-val
   BM lt                                 % check if less than bottom margin
   { showpage LM TM moveto               % New page
     /ypos TM def }
   { ypos lineheight sub                 % Go left/down
     /ypos exch def
     LM ypos moveto } ifelse
} def

/prtstr
 { dup stringwidth pop      % calc length of string
   currentpoint pop         % get horizontal position
   add RM gt                % sum > right margin?
   {newline} if             % if so, next line
   show
} def

/setnormal { font_normal setfont } bind def
/setbold { font_bold setfont } bind def

%% ---- Utils ------

/min  %% int int -- int   | Return min of two ints
{
   2 copy gt { exch pop } { pop } ifelse
} bind def

/max  %% int int -- int   | Return max of two ints
{
   2 copy lt { exch pop } { pop } ifelse
} bind def

/append   %% array elem -- array with elem   | Append elem to array, returning a new array with result.
{
   1 index length dup 1 add array   % Create new larger array.
   dup 0 6 -1 roll putinterval      % Copy old array into new.
   dup 4 -2 roll                    % Duplicate array and stack roll.
   exch put                         % Put element to end.
} bind def


%% --- Step 1 ----------

% Nodes: data structure for Donld Knuth's DLX.

/nodes.init    %% width height --
{
   /nodes.height exch def
   /nodes.width exch def

   % All nodes stored in an array with dicts.
   /nodes 20 array def

   % Create header node.
   /nodes.HEAD_ID 0 def
   nodes nodes.HEAD_ID <<
      /L nodes.HEAD_ID /R nodes.HEAD_ID /U nodes.HEAD_ID /D nodes.HEAD_ID
   >> put

   % Enumerate nodes from 1 and up.
   /nodes.insert_id 1 def

   nodes.width nodes.create_column_headers
} bind def


/nodes.create_column_headers     %% width --
{
   /prev_col nodes.HEAD_ID def

   1 1 3 -1 roll
   {
      /col exch def

      nodes col <<
      /L prev_col
      /R nodes.HEAD_ID     % No known right index. Updated below, but OK for last.
      /U col
      /D col
      /C col
      /S 0
      >> put

      nodes prev_col get /R col put  % Point prev.right to new
      /prev_col col def
   } for

   nodes nodes.HEAD_ID get /L col put  % Point head left to last
   /nodes.insert_id col 1 add def
} bind def


/nodes.inc_column_size     %% column_id --   | Increase given column header size (S) with 1.
{
   nodes exch get dup /S get 1 add /S exch put
} bind def


/nodes.dec_column_size     %% column_id --   | Decrease given column header size (S) with 1.
{
   nodes exch get dup /S get 1 sub /S exch put
} bind def


/nodes.add_row    % columns-array --  | Add a new row with specified columns.
{
   /columns exch def
   /first_id nodes.insert_id def

   /added_ids [] def

   % Add nodes for row and link then vertically in columns.
   columns
   {
      /column_id exch def

      /column_node nodes column_id get def
      /above_node_id column_node /U get def
      /above_node nodes above_node_id get def

      nodes nodes.insert_id
      <<
         /L 0 /R 0
         /U above_node_id
         /D column_id
         /C column_id
      >> put

      above_node /D nodes.insert_id put   % Point above.down to this.
      column_node /U nodes.insert_id put  % Point head.up to this.
      column_id nodes.inc_column_size

      /added_ids added_ids nodes.insert_id append def    % Keep track of added ID
      /nodes.insert_id nodes.insert_id 1 add def
   } forall

   % Link new nodes horizontally.
   /prev_id added_ids dup length 1 sub get def
   added_ids
   {
      /id exch def
      /node nodes id get def
      node /L prev_id put
      nodes prev_id get /R id put
      /prev_id id def
   } forall
} bind def


/nodes.cover    % column_index --  | Cover column (unlink column head and unlink all rows horizontally)
{
   /column_id exch def

   % Unlink column header horizontally.
   /column_node nodes column_id get def
   /l column_node /L get def
   /r column_node /R get def

   nodes l get /R r put
   nodes r get /L l put

   % Iterate over all rows in column (all nodes), downwards.
   /cy column_node /D get def       % cy = column_header.down
   {
      cy column_id eq { exit } if   % Reached column head, stop.

      /row_node nodes cy get def    % Row node

      /cx row_node /R get def       % Go right
      {
         cx cy eq { exit } if       % Break inner loop when we are back ar column.

         /h_node nodes cx get def   % Horizontal node
         /u h_node /U get def
         /d h_node /D get def

         nodes u get /D d put       % Link above.down = below
         nodes d get /U u put       % Link below.up = above

         h_node /C get nodes.dec_column_size

         /cx h_node /R get def      % Set cx to next node right.
      } loop

      /cy row_node /D get def       % Set cy to next node below.
   } loop
} bind def


/nodes.uncover    % column_index --  | Uncover column (relink all rows horizontally and relink coiumn header)
{
   /column_id exch def
   /column_node nodes column_id get def

   % Iterate over all rows in column (all nodes), upwards (reverse).
   /cy column_node /U get def       % cy = column_header.up
   {
      cy column_id eq { exit } if   % Reached column head, stop.

      /row_node nodes cy get def    % Row node

      /cx row_node /L get def       % Go left (reverse)
      {
         cx cy eq { exit } if       % Break inner loop when we are back ar column.

         /h_node nodes cx get def   % Horizontal node
         /u h_node /U get def
         /d h_node /D get def

         nodes u get /D cx put       % Relink above.down = cx
         nodes d get /U cx put       % Relink below.up = cx

         h_node /C get nodes.inc_column_size

         /cx h_node /L get def      % Set cx to next node left.
      } loop

      /cy row_node /U get def       % Set cy to next node above.
   } loop

   % Relink column header horizontally.
   /l column_node /L get def
   /r column_node /R get def

   nodes l get /R column_id put
   nodes r get /L column_id put
} bind def


/nodes_print
{
   /i 0 def
   nodes
   {
      dup null eq
      {
         pop exit
      }
      {
         {
            exch
            ([) print i 10 string cvs print (]  ) print
            (key: ) print 10 string cvs print (, value: ) print 10 string cvs println
         } forall
      } ifelse
      /i i 1 add def
   } forall
} bind def



%% --- Step 2 ----------


%% ------------------------------

setup_output

4 2 nodes.init
nodes_print

(----------------------------) =
[1 3 4] nodes.add_row
nodes_print

(----------------------------) =
[2 3 4] nodes.add_row
nodes_print

(--- Cover ------------------) =
3 nodes.cover
nodes_print

(--- Uncover ------------------) =
3 nodes.uncover
nodes_print


